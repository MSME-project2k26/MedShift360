# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx) so rate limits see the real client IP
TRUST_PROXY=0

# ---------- Supabase ----------
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server-side ONLY - never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-a-different-long-random-string-32-chars
AADHAAR_HASH_SECRET=change-me-to-another-long-random-string-32-chars

# ---------- Token lifetimes ----------
JWT_ACCESS_EXPIRES_IN=30m
# Long-lived sessions so elderly users are not forced to log in repeatedly
REFRESH_TOKEN_TTL_DAYS=30

# ---------- OTP ----------
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5
# When true (and NODE_ENV is not production) the OTP is returned in the API response as "devOtp" for frontend testing
OTP_DEV_ECHO=true

# ---------- SMS (console | twilio | msg91) ----------
# msg91 is the recommended provider for India (DLT-compliant). See README section 6.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 Dashboard -> Authkey
MSG91_AUTH_KEY=
# MSG91 template IDs (each linked to a DLT-approved template)
MSG91_OTP_TEMPLATE_ID=
MSG91_CAREGIVER_TEMPLATE_ID=

# ---------- Email (console | smtp) ----------
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MedShift360 <no-reply@medshift360.in>"

# ---------- Nearby hospitals & doctors (OpenStreetMap, free, no key) ----------
# Overpass API mirrors, tried in order. Optional: the defaults below are used when unset.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
# How long live results are reused for the same area (seconds)
PLACES_CACHE_TTL_SECONDS=600

# ---------- Aadhaar (mock) ----------
# "mock" accepts OTP 123456. Replace with a licensed UIDAI KUA / e-KYC provider adapter before production.
AADHAAR_PROVIDER=mock
