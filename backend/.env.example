# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx) so rate limits see the real client IP
TRUST_PROXY=0

# ---------- Supabase ----------
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server-side ONLY - never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-a-different-long-random-string-32-chars
AADHAAR_HASH_SECRET=change-me-to-another-long-random-string-32-chars

# ---------- Token lifetimes ----------
JWT_ACCESS_EXPIRES_IN=30m
# Long-lived sessions so elderly users are not forced to log in repeatedly
REFRESH_TOKEN_TTL_DAYS=30

# ---------- OTP ----------
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5
# When true (and NODE_ENV is not production) the OTP is returned in the API response as "devOtp" for frontend testing
OTP_DEV_ECHO=true

# ---------- SMS (console | twilio) ----------
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Email (console | smtp) ----------
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MedShift360 <no-reply@medshift360.in>"

# ---------- Aadhaar (mock) ----------
# "mock" accepts OTP 123456. Replace with a licensed UIDAI KUA / e-KYC provider adapter before production.
AADHAAR_PROVIDER=mock
